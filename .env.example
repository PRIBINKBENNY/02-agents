# One API, many models. Swap LLM_MODEL to compare cost and quality on the same task.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4o-mini
# LLM_MODEL=anthropic/claude-haiku-4.5
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Sandbox: E2B (isolated microVM) is used if this is set, otherwise Docker.
# E2B_API_KEY=e2b_...
# Plain subprocess (NOT isolated). Only for CI/tests:
# AGENT_ALLOW_LOCAL_EXEC=1
